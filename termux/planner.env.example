# Stone* Planner — engine environment.
# Copy to planner.env and fill in. Secrets stay in this file, never in code.

# --- Gemini (consultant on the web app). Optional on-device. ---
# GEMINI_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GEMINI_MODEL=gemini-2.0-flash

# --- Engine ---
# HOST=0.0.0.0
# PORT=8787
# STATE_FILE=state.json

# --- Local LLM (set automatically by llama-setup.sh) ---
LOCAL_LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=